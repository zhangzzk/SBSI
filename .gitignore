# ---------------------------------------------------------------------------
# dev -- the full working branch. It tracks the library, examples, tests, the
# documentation in doc/, the archive/ provenance tree, notebooks and slides.
#
# `master` is the trimmed public branch and carries its own, much stricter
# .gitignore. Do not merge dev into master; see doc/BRANCHES.md.
# ---------------------------------------------------------------------------

# ---- large data / output artifacts (live under $DATA_DIR, or regenerable) ----
results/
figures/
data/
!examples/data/
!examples/data/example_catalog.feather

# binary artifacts anywhere
*.pt
*.npz
*.npy
*.feather
!examples/data/example_catalog.feather
*.parquet
*.h5
*.hdf5
*.png
*.pdf
*.stale_bak

# ---- exception: the frozen V3 release artifacts ARE tracked (see models/README.md) ----
!models/
!models/**

# ---- python / tooling caches ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
sbsi.egg-info/

# ---- agent / editor scratch ----
.claude/worktrees/
.claude_resources.json
*.orig
*.swp
*.rblendbak
*.swabak

# ---- job logs (also written outside the repo) ----
jobs/logs/
logs/
*.out
*.err

# ---- LaTeX build products (slides/); the .tex source is tracked ----
*.aux
*.bbl
*.blg
*.log
*.nav
*.snm
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
