{
  "schema_version": 1,
  "name": "Infer V1",
  "description": "First frozen catalogue-shear inference setup; model releases are versioned separately.",
  "prior": "configs/default_catalogue_prior.json",
  "proposal": {
    "flow_samples": 128,
    "location_statistic": "mean",
    "dispersion_statistic": "std",
    "candidates": 16384,
    "prefilter_candidates": 131072,
    "draws": 16384,
    "epsilon": 0.1,
    "method": "initial_center_posterior_adapted"
  },
  "estimator": {
    "initial_strategy": "mean_observed_shape",
    "step": "one_step_full_2d",
    "finite_difference_h": 0.001
  },
  "execution": {
    "precision": "fp32",
    "compile_flow": true,
    "object_chunk": 128,
    "atom_chunk": 4096
  }
}
